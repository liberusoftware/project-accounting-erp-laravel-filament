{
  "type": "liberu-module",
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\MultiCurrencyApi\\MultiCurrencyApiServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-multi-currency-api"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\MultiCurrencyApi\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "name": "liberusoftware/module-accounting-multi-currency-api",
  "description": "Multi-currency API adapter.",
  "require": {
    "illuminate/http": "^13.38.0",
    "illuminate/routing": "^13.38.0",
    "liberusoftware/module-accounting-erp": "^1.0",
    "liberusoftware/module-accounting-multi-currency": "^1.0",
    "php": "^8.5"
  },
  "version": "1.0.3",
  "license": "MIT"
}
