{
  "name": "liberusoftware/module-accounting-bank-accounts-api",
  "description": "HTTP API adapter for bank accounts.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "illuminate/http": "^13.38.0",
    "illuminate/routing": "^13.38.0",
    "liberusoftware/module-accounting-bank-accounts": "^1.0",
    "liberusoftware/module-accounting-erp": "^1.0",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\BankAccountsApi\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\BankAccountsApi\\BankAccountsApiServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-bank-accounts-api"
    }
  },
  "version": "1.0.2",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
