{
  "name": "liberusoftware/module-accounting-estimates-and-quotes-api",
  "description": "HTTP API for estimates and quotes.",
  "type": "liberu-module",
  "license": "MIT",
  "version": "1.1.0",
  "require": {
    "illuminate/http": "^13.38.0",
    "illuminate/routing": "^13.38.0",
    "liberusoftware/module-accounting-erp": "^1.0",
    "liberusoftware/module-accounting-estimates-and-quotes": "^1.0",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\EstimatesAndQuotesApi\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\EstimatesAndQuotesApi\\EstimatesAndQuotesApiServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-estimates-and-quotes-api"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
