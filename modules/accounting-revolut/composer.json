{
    "name": "liberusoftware/module-accounting-revolut",
    "description": "Revolut adapter for Accounting bank feeds and bank payments.",
    "type": "liberu-module",
    "license": "MIT",
    "require": {
        "illuminate/http": "^13.38.0",
        "illuminate/support": "^13.38.0",
        "liberusoftware/integrations": "^1.9",
        "liberusoftware/module-accounting-bank-feeds": "^1.0",
        "liberusoftware/module-accounting-erp": "^1.0",
        "liberusoftware/payment-contracts": "^1.0",
        "liberusoftware/payment-core": "^1.0",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Accounting\\Revolut\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liberu\\Accounting\\Revolut\\RevolutServiceProvider"
            ]
        },
        "liberu": {
            "name": "accounting-revolut"
        }
    },
    "version": "1.0.1",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
