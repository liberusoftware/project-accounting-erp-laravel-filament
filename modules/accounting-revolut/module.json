{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "accounting-revolut",
  "display_name": "Accounting Revolut",
  "description": "Revolut provider adapter for bank feeds and payments.",
  "version": "1.0.1",
  "category": "adapter",
  "provider": "Liberu\\Accounting\\Revolut\\RevolutServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/integrations": "^1.9",
      "liberusoftware/module-accounting-bank-feeds": "^1.0",
      "liberusoftware/module-accounting-erp": "^1.0",
      "liberusoftware/payment-contracts": "^1.0",
      "liberusoftware/payment-core": "^1.0"
    }
  },
  "capabilities": [
    "accounting.bank-feeds.provider.revolut",
    "accounting.bank-payments.provider.revolut"
  ],
  "features": [
    "Account synchronization",
    "Transaction synchronization",
    "Single payments",
    "Bulk payment drafts",
    "Token refresh"
  ],
  "default_enabled": true
}
