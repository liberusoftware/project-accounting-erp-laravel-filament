{
  "name": "liberusoftware/module-accounting-supplier-portal-filament",
  "description": "Supplier portal Filament adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "filament/filament": "^5.11.0",
    "liberusoftware/module-accounting-erp": "^1.0",
    "liberusoftware/module-accounting-supplier-portal": "^1.0",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\SupplierPortalFilament\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\SupplierPortalFilament\\SupplierPortalFilamentServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-supplier-portal-filament"
    }
  },
  "version": "1.1.1",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
