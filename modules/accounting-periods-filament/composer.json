{
  "type": "liberu-module",
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\PeriodsFilament\\AccountingPeriodsFilamentServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-periods-filament"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\PeriodsFilament\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "name": "liberusoftware/module-accounting-periods-filament",
  "description": "Filament adapter for accounting periods.",
  "require": {
