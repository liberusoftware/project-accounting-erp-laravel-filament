{
  "type": "liberu-module",
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\PeriodsApi\\AccountingPeriodsApiServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-periods-api"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\PeriodsApi\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "name": "liberusoftware/module-accounting-periods-api",
  "description": "Authenticated API adapter for accounting periods.",
  "require": {
    "laravel/framework": "^13.38.0",
    "php": "^8.5",
    "liberusoftware/module-accounting-periods": "^1.0",
    "laravel/sanctum": "^4.3.3"
  },
  "version": "1.0.3",
  "license": "MIT"
}
