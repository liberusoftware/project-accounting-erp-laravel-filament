{
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-accounting-payroll-integration": "^1.0"
    }
  },
  "display_name": "Accounting Payroll Integration Filament",
  "capabilities": [
    "accounting.payroll-integration.filament"
  ],
  "category": "presentation",
  "name": "accounting-payroll-integration-filament",
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "description": "Filament 5 surfaces for payroll imports.",
  "default_enabled": true,
  "features": [
    "Imports",
    "Validation",
    "Reconciliation"
  ],
  "version": "1.0.1",
  "provider": "Liberu\\Accounting\\PayrollIntegrationFilament\\PayrollIntegrationFilamentServiceProvider",
  "presentation": {
    "filament": {
      "app": [
        "Liberu\\Accounting\\PayrollIntegrationFilament\\PayrollIntegrationFilamentPlugin"
      ]
    }
  }
}
