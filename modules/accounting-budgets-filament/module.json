{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "accounting-budgets-filament",
  "display_name": "Accounting Budgets Filament",
  "description": "Filament workspace for budgets.",
  "version": "1.1.1",
  "category": "presentation",
  "provider": "Liberu\\Accounting\\BudgetsFilament\\BudgetsFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-accounting-budgets": "^1.0"
    }
  },
  "capabilities": [
    "accounting.budgets.filament"
  ],
  "features": [
    "Budget planning table",
    "Approval actions",
    "Version visibility"
  ],
  "default_enabled": true,
  "presentation": {
    "filament": {
      "app": [
        "Liberu\\Accounting\\BudgetsFilament\\BudgetsFilamentPlugin"
      ]
    }
  }
}
