{
  "type": "liberu-module",
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\MigrationFramework\\MigrationFrameworkServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-migration-framework"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\MigrationFramework\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "name": "liberusoftware/module-accounting-migration-framework",
  "description": "Accounting migration sources, mappings, dry runs, batches, resume, errors and reconciliation.",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.38.0",
    "illuminate/database": "^13.38.0"
  },
  "version": "1.0.2",
  "license": "MIT"
}
