{
    "name": "liberusoftware/module-accounting-xero-migration-api",
    "description": "Accounting Xero migration API presentation module.",
    "type": "liberu-module",
    "license": "MIT",
    "require": {
        "illuminate/http": "^13.38.0",
        "illuminate/routing": "^13.38.0",
        "liberusoftware/module-accounting-erp": "^1.0",
        "liberusoftware/module-accounting-xero-migration": "^1.0",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Accounting\\XeroMigrationApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liberu\\Accounting\\XeroMigrationApi\\XeroMigrationApiServiceProvider"
            ]
        },
        "liberu": {
            "name": "accounting-xero-migration-api"
        }
    },
    "version": "1.0.0",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
