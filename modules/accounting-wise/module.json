{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "accounting-wise",
  "display_name": "Accounting Wise",
  "description": "Wise provider adapter for bank feeds and bank payments.",
  "version": "1.0.3",
  "category": "adapter",
  "provider": "Liberu\\Accounting\\Wise\\WiseServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/integrations": "^1.9",
      "liberusoftware/module-accounting-bank-feeds": "^1.0",
      "liberusoftware/module-accounting-erp": "^1.0",
      "liberusoftware/payment-contracts": "^1.0",
      "liberusoftware/payment-core": "^1.0"
    }
  },
  "capabilities": [
    "accounting.bank-feeds.provider.wise",
    "accounting.bank-payments.provider.wise.single",
    "accounting.bank-payments.provider.wise.bulk"
  ],
  "features": [
    "OAuth authorization",
    "Profile and balance access",
    "Transfer synchronization",
    "Single payments",
    "Bounded bulk payments",
    "Token refresh"
  ],
  "default_enabled": true
}
