{
  "type": "liberu-module",
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\GeneralLedgerApi\\GeneralLedgerApiServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-general-ledger-api"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\GeneralLedgerApi\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "name": "liberusoftware/module-accounting-general-ledger-api",
  "description": "Authenticated API adapter for the accounting general ledger.",
  "require": {
    "laravel/framework": "^13.38.0",
    "liberusoftware/module-accounting-general-ledger": "^1.0",
    "php": "^8.5",
    "laravel/sanctum": "^4.3.3"
  },
  "version": "1.0.1",
  "license": "MIT"
}
