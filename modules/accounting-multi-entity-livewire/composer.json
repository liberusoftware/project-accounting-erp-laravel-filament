{
  "type": "liberu-module",
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\MultiEntityLivewire\\MultiEntityLivewireServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-multi-entity-livewire"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\MultiEntityLivewire\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "name": "liberusoftware/module-accounting-multi-entity-livewire",
  "description": "Multi-entity Livewire 4 adapter.",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.4.8",
    "liberusoftware/module-accounting-multi-entity": "^1.0"
  },
  "version": "1.1.1",
  "license": "MIT"
}
