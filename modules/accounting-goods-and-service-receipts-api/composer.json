    "laravel": {
      "providers": [
        "Liberu\\Accounting\\GoodsAndServiceReceiptsApi\\GoodsAndServiceReceiptsApiServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-goods-and-service-receipts-api"
    }
