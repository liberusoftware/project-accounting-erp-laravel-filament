{
  "name": "liberusoftware/module-accounting-plaid",
  "description": "Plaid adapter for the Accounting Bank Feeds contract.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "illuminate/http": "^13.38.0",
    "illuminate/support": "^13.38.0",
    "liberusoftware/integrations": "^1.4",
    "liberusoftware/module-accounting-bank-feeds": "^1.0",
    "liberusoftware/module-accounting-erp": "^1.0",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\Plaid\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Liberu\\Accounting\\Plaid\\PlaidServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-plaid"
    }
  },
  "version": "1.0.2",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
