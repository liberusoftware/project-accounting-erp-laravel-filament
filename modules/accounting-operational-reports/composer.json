      "providers": [
        "Liberu\\Accounting\\OperationalReports\\OperationalReportsServiceProvider"
      ]
    },
    "liberu": {
      "name": "accounting-operational-reports"
    }
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\OperationalReports\\": "src/"
